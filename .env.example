# Local Postgres connection (used by docker-compose and the app).
# Copy to .env and adjust if needed.
POSTGRES_DB=flowstate
POSTGRES_USER=flowstate
POSTGRES_PASSWORD=flowstate

# .NET connection string override (optional; appsettings has a localhost default)
# ConnectionStrings__FlowState=Host=localhost;Port=5432;Database=flowstate;Username=flowstate;Password=flowstate
