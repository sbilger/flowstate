@page "/tasks"
@using FlowState.Application.Tasks
@using FlowState.Domain.Tasks
@using MediatR
@inject IMediator Mediator
@rendermode InteractiveServer

<PageTitle>Tasks · FlowState</PageTitle>

<h1 class="fs-greet">Brain dump</h1>
<p class="fs-sub">Throw anything in. Sort it out later.</p>

<div class="fs-capture">
    <input class="fs-input" placeholder="Type a task and hit enter…"
           @bind="_newTitle" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <select class="fs-select" @bind="_newEnergy">
        <option value="@EnergyCost.Low">🟢 Low</option>
        <option value="@EnergyCost.Medium">🟡 Medium</option>
        <option value="@EnergyCost.High">🔴 High</option>
    </select>
    <button class="fs-btn fs-btn-primary" @onclick="AddAsync">Add</button>
</div>

@if (_tasks is null)
{
    <p class="fs-muted">Loading…</p>
}
else if (_tasks.Count == 0)
{
    <div class="fs-empty">Nothing here yet. Capture something above.</div>
}
else
{
    <div class="fs-label">@OpenCount open · @_tasks.Count total</div>
    @foreach (var t in _tasks)
    {
        <div class="fs-item">
            <span class="l">
                <span class="fs-dot @EnergyClass(t.EnergyCost)"></span>
                <span style="@(t.Status == TaskItemStatus.Done ? "text-decoration:line-through;opacity:.5" : "")">@t.Title</span>
            </span>
            <span class="t" style="display:flex;gap:10px;align-items:center">
                @if (t.Status == TaskItemStatus.Open)
                {
                    <button class="fs-done-btn" @onclick="() => Complete(t.Id)" title="Mark done">✓ done</button>
                }
                <span>@t.EnergyCost</span>
            </span>
        </div>
    }
}

@code {
    private IReadOnlyList<TaskDto>? _tasks;
    private string _newTitle = string.Empty;
    private EnergyCost _newEnergy = EnergyCost.Medium;

    private int OpenCount => _tasks?.Count(t => t.Status == TaskItemStatus.Open) ?? 0;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _tasks = await Mediator.Send(new GetTasksQuery());

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        await Mediator.Send(new AddTaskCommand(_newTitle, _newEnergy));
        _newTitle = string.Empty;
        _newEnergy = EnergyCost.Medium;
        await Load();
    }

    private async Task Complete(Guid id)
    {
        await Mediator.Send(new CompleteTaskCommand(id));
        await Load();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddAsync();
    }

    private static string EnergyClass(EnergyCost c) => c switch
    {
        EnergyCost.Low => "fs-low",
        EnergyCost.Medium => "fs-medium",
        _ => "fs-high"
    };
}
