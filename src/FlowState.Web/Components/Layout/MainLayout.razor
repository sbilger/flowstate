@inherits LayoutComponentBase
@using FlowState.Domain.Tasks
@using FlowState.Web.Services
@inject UiState Ui
@inject IJSRuntime JS
@implements IDisposable

<div class="fs-shell">
    <header class="fs-top">
        <a class="fs-brand" href="/">
            <span class="fs-mark">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
            </span>
            FlowState
        </a>
        <div class="fs-top-actions">
            <div class="fs-energy" @onclick="CycleEnergy" title="Your current energy">
                <span class="fs-dot @EnergyDotClass"></span>
                Energy · @Ui.Energy
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="fs-toggle" @onclick="ToggleTheme" title="Toggle light / dark">
                <span class="fs-switch">
                    <span class="fs-knob">
                        @if (_isDark)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
                        }
                    </span>
                </span>
            </div>
        </div>
    </header>

    <main class="fs-main">
        @Body
    </main>

    <nav class="fs-nav">
        <NavLink href="/" Match="NavLinkMatch.All">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
            Now
        </NavLink>
        <NavLink href="/inbox">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9 6 9-6M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 7l2-3h14l2 3"/></svg>
            Inbox
        </NavLink>
        <NavLink href="/tasks">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            Tasks
        </NavLink>
        <NavLink href="/insights">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M8 14l3-4 3 3 4-6"/></svg>
            Insights
        </NavLink>
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDark;

    protected override void OnInitialized() => Ui.EnergyChanged += OnEnergyChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("flowstate.getTheme");
            _isDark = theme == "dark";
            StateHasChanged();
        }
    }

    private void CycleEnergy() => Ui.CycleEnergy();

    private async Task ToggleTheme()
    {
        var next = await JS.InvokeAsync<string>("flowstate.toggleTheme");
        _isDark = next == "dark";
    }

    private void OnEnergyChanged() => InvokeAsync(StateHasChanged);

    private string EnergyDotClass => Ui.Energy switch
    {
        EnergyLevel.Good => "fs-low",
        EnergyLevel.Okay => "fs-medium",
        _ => "fs-high"
    };

    public void Dispose() => Ui.EnergyChanged -= OnEnergyChanged;
}
